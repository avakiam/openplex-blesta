<?php /** @var View $this **/ ?>
<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    ['name' => $this->_('Openplex.add_module_row', true), 'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $module->id]],
    ['name' => $this->_('Openplex.add_module_group', true), 'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addgroup/' . $module->id]],
]);
$this->Widget->setTabs([
    ['name' => $this->_('Openplex.manage.tab_rows', true), 'current' => true,
        'attributes' => ['href' => '#openplex_rows', 'id' => 'openplex_rows_tab', 'data-bs-toggle' => 'tab', 'role' => 'tab']],
    ['name' => $this->_('Openplex.manage.tab_groups', true), 'current' => false,
        'attributes' => ['href' => '#openplex_groups', 'id' => 'openplex_groups_tab', 'data-bs-toggle' => 'tab', 'role' => 'tab']],
]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminCompanyModules.manage.boxtitle_manage', true, $this->Html->safe($module->name ?? 'OpenPlex')), ['id' => 'manage_openplex']);
$rows = $module->rows ?? [];
$groups = $module->groups ?? [];
?>
<div class="tab-content">
    <div class="tab-pane fade show active" id="openplex_rows" role="tabpanel">
        <?php if (count($rows) > 0) { ?>
        <table class="table">
            <thead>
                <tr>
                    <th><?php $this->_('Openplex.manage.rows.name'); ?></th>
                    <th><?php $this->_('Openplex.manage.rows.host'); ?></th>
                    <th><?php $this->_('Openplex.manage.rows.port'); ?></th>
                    <th><?php $this->_('Openplex.manage.rows.options'); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($rows as $row) { ?>
                <tr>
                    <td><?php $this->Html->_($row->meta->server_name); ?></td>
                    <td><?php $this->Html->_($row->meta->host_name); ?></td>
                    <td><?php $this->Html->_($row->meta->port); ?></td>
                    <td>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . $module->id . '/' . $row->id . '/'); ?>"><?php $this->_('Openplex.manage.edit'); ?></a>
                        <?php
                        $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', $module->id);
                        $this->Form->fieldHidden('row_id', $row->id);
                        ?>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/deleterow/' . $module->id . '/' . $row->id . '/'); ?>" class="manage" rel="<?php $this->_('Openplex.manage.rows.confirm_delete'); ?>"><?php $this->_('Openplex.manage.delete'); ?></a>
                        <?php $this->Form->end(); ?>
                    </td>
                </tr>
                <?php } ?>
            </tbody>
        </table>
        <?php } else { ?>
        <div class="empty_section"><div class="empty_box"><?php $this->_('Openplex.manage.rows.none'); ?></div></div>
        <?php } ?>
    </div>
    <div class="tab-pane fade" id="openplex_groups" role="tabpanel">
        <?php if (count($groups) > 0) { ?>
        <table class="table">
            <thead>
                <tr>
                    <th><?php $this->_('Openplex.manage.groups.name'); ?></th>
                    <th><?php $this->_('Openplex.manage.groups.servers'); ?></th>
                    <th><?php $this->_('Openplex.manage.rows.options'); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($groups as $group) { ?>
                <tr>
                    <td><?php $this->Html->_($group->name); ?></td>
                    <td><?php echo count($group->rows ?? []); ?></td>
                    <td>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editgroup/' . $module->id . '/' . $group->id . '/'); ?>"><?php $this->_('Openplex.manage.edit'); ?></a>
                        <?php
                        $this->Form->create($this->base_uri . 'settings/company/modules/deletegroup/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', $module->id);
                        $this->Form->fieldHidden('group_id', $group->id);
                        ?>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/deletegroup/' . $module->id . '/' . $group->id . '/'); ?>" class="manage" rel="<?php $this->_('Openplex.manage.groups.confirm_delete'); ?>"><?php $this->_('Openplex.manage.delete'); ?></a>
                        <?php $this->Form->end(); ?>
                    </td>
                </tr>
                <?php } ?>
            </tbody>
        </table>
        <?php } else { ?>
        <div class="empty_section"><div class="empty_box"><?php $this->_('Openplex.manage.groups.none'); ?></div></div>
        <?php } ?>
    </div>
</div>
<?php $this->Widget->end(); ?>
<script type="text/javascript">
$(document).ready(function() {
    $('#manage_openplex a.manage[rel]').blestaModalConfirm({base_url: '<?php echo $this->base_uri; ?>', close: '<?php $this->_('AppController.modal.text_close'); ?>', submit: true});
});
</script>
